# DECISION_MODEL=typesafe/jev-1.13

# PERSONA_PATH=config/persona.md
# HISTORY_LEN=30
# IDLE_TIMEOUT_SECS=300
# MAX_TURNS=20
# RUST_LOG=info,time_to_bot=debug
