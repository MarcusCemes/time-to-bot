DISCORD_TOKEN=
OPENROUTER_API_KEY=

# Reply model: any OpenRouter model slug, or @preset/<slug>
LLM_MODEL=

# Optional (defaults shown)
# LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions   # EU: https://eu.openrouter.ai/api/v1/chat/completions
# LLM_REASONING_EFFORT=low

